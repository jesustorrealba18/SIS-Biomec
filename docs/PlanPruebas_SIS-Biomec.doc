  <tr><td>CP-INT-01..06</td><td>Usuario</td><td>Crear con rol (hash bcrypt), duplicado, actualizar, toggleActivo, reset con desbloqueo, eliminar</td><td class="ok">&#10004;</td></tr>
  <tr><td>CP-INT-07..12</td><td>Atleta</td><td>setDatos v&aacute;lido (token 32 hex), guardar (doble tabla), datos incompletos, actualizar, borrado l&oacute;gico, listar</td><td class="ok">&#10004;</td></tr>
  <tr><td>CP-INT-13..17</td><td>Evento</td><td>Registrar+detalle, editar, m&aacute;quina de estados (10 transiciones), inscripci&oacute;n idempotente, conflictos de fechas</td><td class="ok">&#10004;</td></tr>
  <tr><td>CP-INT-18..21</td><td>Notificaci&oacute;n</td><td>Enviar+listar, conteo no le&iacute;das idempotente, propiedad al marcar, resoluci&oacute;n por correo</td><td class="ok">&#10004;</td></tr>
  <tr><td>CP-INT-22..23</td><td>RBAC</td><td>cargarPermisos con usuario real; usuario sin roles &rarr; privadas denegadas</td><td class="ok">&#10004;</td></tr>
  <tr><td>CP-INT-24..28</td><td>Test F&iacute;sico</td><td>Crear tipo con variables, registrar con unidad auto-resuelta y estado default, rechazos sin valores/sin tipo, estado expl&iacute;cito</td><td class="ok">&#10004;</td></tr>
  <tr><td>CP-INT-29</td><td>Test F&iacute;sico</td><td>Actualizar con estado expl&iacute;cito &mdash; datos y valores reemplazados (2&rarr;1)</td><td class="ok">&#10004;</td></tr>
  <tr><td>CP-INT-30</td><td>Test F&iacute;sico</td><td><b>Actualizar sin estado corrompe silenciosamente</b> (estado queda '' &mdash; hallazgo TF-5)</td><td class="ok">&#10004; documenta</td></tr>
  <tr><td>CP-INT-31</td><td>Test F&iacute;sico</td><td>Actualizar con datos id&eacute;nticos &rarr; rowCount 0 &rarr; "no encontrado" (TF-2b)</td><td class="ok">&#10004; documenta</td></tr>
  <tr><td>CP-INT-32..35</td><td>Test F&iacute;sico</td><td>Eliminar test (valores+registro), inexistente, tipo con registros bloqueado, tipo sin registros eliminable</td><td class="ok">&#10004;</td></tr>
  <tr><td>CP-INT-36</td><td>Test F&iacute;sico</td><td>Personalizado con creador: persiste, listado filtrado con variables</td><td class="ok">&#10004;</td></tr>
  <tr><td>CP-INT-37</td><td>Test F&iacute;sico</td><td>Personalizado sin creador &rarr; id_usuario_creador=0 (hallazgo TF-3)</td><td class="ok">&#10004; documenta</td></tr>
  <tr><td>CP-INT-38..39</td><td>Test F&iacute;sico</td><td>Detalle con valores ordenados e historial solo Completo; resumen cuenta solo Completos</td><td class="ok">&#10004;</td></tr>
  <tr><td>CP-INT-40..42</td><td>Observaciones</td><td>Registrar completa; sin id_usuario &rarr; error BD gen&eacute;rico (OF-1); calificaci&oacute;n '9' rechazada</td><td class="ok">&#10004;</td></tr>
  <tr><td>CP-INT-43..45</td><td>Observaciones</td><td>Actualizar calificaci&oacute;n/texto; id inexistente; borrado f&iacute;sico no idempotente</td><td class="ok">&#10004;</td></tr>
  <tr><td>CP-INT-46..48</td><td>Observaciones</td><td>Listar filtro por atleta; detalle con historial por aspecto (ascendente); resumen promedio 4.0 / max 5 / min 3</td><td class="ok">&#10004;</td></tr>
</table>

